# Copy to .env (which is gitignored). Required for `npm run dev`.

# Drupal/MariaDB connection. For dev, point at staging via an SSH tunnel:
#   ssh -L 3307:127.0.0.1:3306 staging
# then set DB_HOST=127.0.0.1, DB_PORT=3307 below.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cgweb_ro
DB_PASSWORD=
DB_NAME=

# Random secret for signing JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=

# --- PHP cgmembers handoff -------------------------------------------------
# So a successful login here also signs the user in on the existing PHP member
# site, and menu links land pre-authenticated. Leave PHP_SSO_URL empty to skip
# the handoff during local dev where PHP isn't reachable.

# The PHP /cgpay-sso endpoint. Same host as the member site.
PHP_SSO_URL=

# Shared secret. Must match the cgmembers config.json key "cgpaySsoSecret".
# Generate with: openssl rand -base64 48
PHP_SSO_SECRET=

# Cookie domain for the PHP session cookie set on successful login. Must be a
# parent of BOTH this app's host and the PHP host, e.g. ".commongood.earth".
PHP_COOKIE_DOMAIN=

# Public base URL of the PHP member site — used by the dashboard to build menu
# links (e.g. History -> ${PUBLIC_PHP_BASE_URL}/history). The PUBLIC_ prefix is
# required by SvelteKit to expose it to the browser.
PUBLIC_PHP_BASE_URL=
