# Copy to .env (which is gitignored). Required for `npm run dev`.
#
# Every variable below is required - startup validation (hooks.server.ts) will
# refuse to boot and print the full list of missing values if any are blank.
# See cgpay #178 for the rationale (silent fallbacks previously turned config
# errors into "login looks successful, then every page is signed out").

# Drupal/MariaDB connection. For dev, point at test, dev, or staging server via an SSH tunnel:
#   ssh -L 3307:127.0.0.1:3306 staging
# then set DB_HOST=127.0.0.1, DB_PORT=3307 below.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=test_ro
DB_PASSWORD=testpw
DB_NAME=test

# --- PHP cgmembers handoff -------------------------------------------------
# A successful login here also signs the user in on the existing PHP member
# site, and menu links land pre-authenticated.

# Public base URL of the PHP member site. The PUBLIC_ prefix is required by
# SvelteKit to expose it to the browser. The node app derives three things
# from this value: the /cgpay/sso and /cgpay/grants endpoints, and the parent
# cookie domain. Set this per environment and the handoff follows.
PUBLIC_PHP_BASE_URL=http://localhost/cg/cgmembers

# Shared secret for server-to-server /cgpay-* calls. Must match the cgmembers
# config.json key "cgpaySsoSecret". Generate with: openssl rand -base64 48
PHP_SSO_SECRET=

# The Drupal session cookie name (returned by /cgpay/sso as `cookieName`,
# e.g. SESS6f32aa4e40e718e5209855e0f99f3d31). node can't derive this reliably
# since Drupal computes it from the cookie_domain setting at bootstrap. Copy
# the value /cgpay/sso returns on first login against your target PHP host.
PHP_SSO_COOKIE_NAME=

# Legacy CGPay PWA base URL, used for camera-enabled Pay and Charge handoffs.
CGPAY_PWA_URL=http://localhost:3000

# --- Cloudflare Turnstile captcha ------------------------------------------
# Invisible captcha on /signup. Jose picked Turnstile over hCaptcha and reCAPTCHA
# for privacy posture (no cross-site tracking). The sitekey is public (renders
# in the browser); the matching secret lives on PHP's config.json key
# "turnstileSecret" and is verified server-side on /cgpay-signup.
#
# The default below is Cloudflare's documented always-pass TEST sitekey - fine
# for dev + CI. Swap for a real sitekey from the Cloudflare dashboard before
# shipping to prod (and pair it with the matching secret in cgmembers config.json).
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Where to receive requests on the server
# local:80, test:3001, dev:3002, staging:3003, demo:3004, main:3001, beta:3002
PORT=80

# Allow admin to sign in with any non-empty password (never in production!)
TEST_ADMIN_BYPASS=1
