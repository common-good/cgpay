#!/bin/bash
# usage: sudo install MODE SRC DEST   Renders SRC (see render) and installs it as DEST, owned by root.
set -euo pipefail
[ $# -eq 3 ] || { echo "usage: install MODE SRC DEST" >&2; exit 1; }
D=$(dirname "$(readlink -f "$0")"); T=$(mktemp); trap 'rm -f "$T"' EXIT
"$D/render" "$2" > "$T"
/usr/bin/install -m "$1" -o root -g root "$T" "$3"
