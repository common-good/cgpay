# Copy to site.env (gitignored) and fill in; render and install substitute these into the files in this directory.
# Your domain; the hostnames in the nginx confs and scripts are all under it.
DOMAIN=example.org
# Prefix of the standby marker files, /etc/<ORG>-standby and /etc/<ORG>-standby-web-blocked.
ORG=example
# Where cert-expiry alerts go, the From address of alert mail, and where cron failure mail goes.
ALERT_TO=ops@example.org
ALERT_FROM=alerts@example.org
TECH_TO=ops@example.org
# Name of the ssh client alias that reaches the standby for lsyncd (set up in your ssh client settings).
SYNC_HOST=standby-sync
