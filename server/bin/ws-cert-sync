#!/bin/sh
# Copies the wildcard cert to the paths the legacy app's websocket (cgmembers rcron/app-socket.php) hardcodes.
# Runs daily from /etc/cron.daily (symlink) so renewals follow; the key is readable by the main user, which runs the switchboard.
set -e
L=/etc/letsencrypt/live/{{DOMAIN}}
install -d /etc/pki/tls/certs /etc/pki/tls/private
install -m 644 -o root -g root $L/fullchain.pem /etc/pki/tls/certs/{{DOMAIN}}.pem
install -m 640 -o root -g main $L/privkey.pem /etc/pki/tls/private/{{DOMAIN}}.key
