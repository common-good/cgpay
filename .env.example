# Build-time settings for the legacy cgpay app (Vite reads VITE_* when the app is built; rebuild after changing).
# Copy to .env for local work.

# Base URL of the node dashboard. After a handoff (member came from the dashboard), a 401 from the server
# sends the member to ${VITE_CGPAY_DASHBOARD_URL}/login. If unset, the member sees a sign-in message instead.
# Use the same value as cgpayUrl in the PHP config for the environment you are building for:
#   local:       http://localhost:5173
#   cgpay-test:  https://cgpay-test.commongood.earth
#   production:  the node dashboard's public URL (no trailing slash)
VITE_CGPAY_DASHBOARD_URL=http://localhost:5173
